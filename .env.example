# vectorDB
PINECONE_API_KEY=your_api_key
PINECONE_INDEX=dm-knowledge
PINECONE_INDEX_KNOWLEDGE=dm-knowledge
PINECONE_INDEX_MEMORY=dm-memory

# embed and rerank
EMBEDDING_PROVIDER_TYPE=nvidia
RERANKER_PROVIDER_TYPE=mock

NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIMENSION=1024

# Optional local/self-hosted embedding endpoint:
# EMBEDDING_PROVIDER_TYPE=http
# EMBEDDING_PROVIDER_URL=http://localhost:8001/embeddings

# langsmith
LANGSMITH_API_KEY=your_api_key
LANGSMITH_PROJECT=My First App
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=mimic_master
MONGODB_USERNAME=your_username
MONGODB_PASSWORD=your_password

# vision
ZHIPU_API_KEY=your_api_key_here
VISION_PROVIDER_URL=https://open.bigmodel.cn/api/paas/v4/completions
VISION_MODEL=glm-4.6v
